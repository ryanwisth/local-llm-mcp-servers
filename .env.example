# Copy to .env (never commit it) or export these in the shell that starts your MCP client.

# Twelve Data REST API key. Free key: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=your-twelvedata-key-here

# World Monitor. Leave the key empty to use the browser login (`--login`) instead.
# A static wm_ key exists only on paid API plans or on a self-hosted World Monitor stack.
WORLDMONITOR_API_KEY=
# Optional: point at a self-hosted stack instead of https://worldmonitor.app/mcp
WORLDMONITOR_MCP_URL=
# Optional: where browser-login tokens are stored (default ~/.config/mcp-worldmonitor/oauth)
WORLDMONITOR_OAUTH_DIR=

# yfinance needs no key.
